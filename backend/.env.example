FLASK_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-jwt-secret-in-production

# PostgreSQL (Docker: docker compose up -d) or Supabase connection string:
DATABASE_URL=postgresql://payslip:payslip_secret@localhost:5432/payslip_db
# Quick local dev without Postgres — set to true:
USE_SQLITE=true

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

UPLOAD_FOLDER=storage/uploads
PAYSLIP_FOLDER=storage/payslips

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@company.com
SMTP_USE_TLS=true

ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=admin123

FLASK_ENV=development
SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-jwt-secret-in-production

# Database: SQLite (default, no install) OR Supabase Postgres
USE_SQLITE=true
# When USE_SQLITE=false, set your Supabase / Postgres URI:
# DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres?sslmode=require

# Background jobs: true = PDFs/emails run inside Flask (no Redis, no Celery worker)
CELERY_TASK_ALWAYS_EAGER=true
# Optional async mode (requires Redis + separate celery worker):
# CELERY_TASK_ALWAYS_EAGER=false
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Supabase Storage (uploads + payslip PDFs)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_UPLOAD_BUCKET=uploads
SUPABASE_PAYSLIP_BUCKET=payslips

# Local file fallback when Supabase keys are empty:
UPLOAD_FOLDER=storage/uploads
PAYSLIP_FOLDER=storage/payslips

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@company.com
SMTP_USE_TLS=true

ADMIN_EMAIL=admin@company.com
ADMIN_PASSWORD=admin123

# Shown on payslip PDFs and in email body
COMPANY_NAME=Nippon Toyota
